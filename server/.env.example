NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_billing?replicaSet=rs0
# Set only when the system DNS resolver cannot resolve MongoDB Atlas SRV records.
# DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
SERVER_URL=http://localhost:4000
DEMO_USER_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
# Required for password-reset emails. Create a key at https://resend.com.
RESEND_API_KEY=
PASSWORD_RESET_FROM="Hospital Billing <no-reply@your-verified-domain.com>"
PASSWORD_RESET_TTL_MINUTES=20
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
